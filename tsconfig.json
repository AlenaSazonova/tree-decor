{
    "compilerOptions": {
        "strict": true,
        "jsx": "react-jsx",
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "allowJs": true,  //false
        "checkJs": false
    },
    "include": [
        "src/**/*",
        "node_modules/react-scripts/lib/**/*"
    ]
}